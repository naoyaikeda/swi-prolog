Bootstrap: docker
From: alpine:latest

%files
    apps /apps

%post
    apk update
    apk upgrade
    apk add curl
    apk add git
    apk add --no-cache bash
    apk add --no-cache python3 py3-pip
    apk add --no-cache swi-prolog --repository=http://dl-cdn.alpinelinux.org/alpine/edge/testing
    apk add --no-cache starship
    apk add --no-cache openssh

    # Generate SSH host keys
    ssh-keygen -A

    # Set SSH port to 8822 to avoid conflict with host
    sed -i 's/#Port 22/Port 8822/' /etc/ssh/sshd_config
    # Ensure Port is set even if not found in default config
    grep -q "^Port 8822" /etc/ssh/sshd_config || echo "Port 8822" >> /etc/ssh/sshd_config

    curl -LsSf https://astral.sh/uv/install.sh | sh

    cp /root/.local/bin/uv /usr/local/bin/uv
    chmod +x /usr/local/bin/uv

    chmod 777 /apps
    cd /apps

    uv init
    uv add jupyter notebook jupyter-swi-prolog

    # 1. 設置ディレクトリを確実に作成
    mkdir -p /usr/local/share/jupyter/kernels/swi_prolog_kernel

    # 2. kernel.json を手動で生成し、パスを絶対パスで固定する
    cat <<EOF > /usr/local/share/jupyter/kernels/swi_prolog_kernel/kernel.json
{
 "argv": [
  "/apps/.venv/bin/python3",
  "-m",
  "swi_prolog_kernel",
  "-f",
  "{connection_file}"
 ],
 "display_name": "SWI-Prolog (Fixed)",
 "language": "prolog"
}
EOF

    # 3. 実行に必要な .py ファイル群をパッケージからコピー
    K_SRC=$(uv run python -c "import swi_prolog_kernel; import os; print(os.path.dirname(swi_prolog_kernel.__file__))")
    cp -r $K_SRC/* /usr/local/share/jupyter/kernels/swi_prolog_kernel/

    # 4. 全ユーザーが実行・読み取りできるように権限設定
    chmod -R 755 /usr/local/share/jupyter/kernels/swi_prolog_kernel

%environment
    export SHELL=/bin/bash
